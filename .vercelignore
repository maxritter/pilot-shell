# Only the public website, documentation and their shared images are deployable.
/*
!/docs
/docs/*
!/docs/site
!/docs/docusaurus
!/docs/img

# Exclude local credentials, build output and public API regression-test routes.
**/node_modules/**
**/dist/**
**/build/**
**/.docusaurus/**
**/.env*
**/.DS_Store
**/*.log
**/*.test.ts
**/*.test.tsx
