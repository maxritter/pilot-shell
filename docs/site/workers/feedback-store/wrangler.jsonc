{
  // Private store for feedback screenshots. The only holder of the bucket; the site's API reaches
  // it with a shared secret (STORE_SECRET, set with `wrangler secret put STORE_SECRET`).
  "name": "qualitylayer-feedback-store",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "qualitylayer-feedback" }]
}
