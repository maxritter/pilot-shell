#!/usr/bin/env bash
# Pre-commit hook: the fast CI checks, in parallel, scoped to what is staged.
#
#   • qualitylayer   Biome on the staged files; typecheck when TypeScript is staged,
#                    on the staged tree when another session has unstaged work   (qualitylayer/ staged)
#   • app (Rust)     cargo fmt --check + clippy -D warnings   (a crate under app/ staged)
#   • plaintext      nothing under qualitylayer/ staged in plaintext   (always)
#   • shell          shellcheck                          (shell scripts or hooks staged)
#   • workflows      actionlint                          (.github/workflows/ staged)
#   • trivy          vuln + secret scan                  (always)
#
# The test suite is CI's job (`bun run test` in qualitylayer/, a few minutes).
# Missing local tools are skipped with a warning, never blocking: CI is the gate.
#
# Install: ln -sf ../../.github/hooks/pre-commit .git/hooks/pre-commit
# Bypass:
#   SKIP_PRECOMMIT=1   skip everything (or: git commit --no-verify)
#   SKIP_TRIVY=1       skip the security scan

set -uo pipefail

serial="${QUALITYLAYER_PRECOMMIT_SERIAL:-0}"
case "$serial" in
  0|1) : ;;
  *) echo "invalid QUALITYLAYER_PRECOMMIT_SERIAL: expected 0 or 1" >&2; exit 1 ;;
esac

if [ "${SKIP_PRECOMMIT:-0}" = "1" ]; then
  echo "⚠ SKIP_PRECOMMIT=1 — skipping all pre-commit checks."
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

# --- Author identity gate ------------------------------------------------------
#
# A throwaway identity in .git/config silently re-authors every commit in the
# repo (repo config wins over ~/.gitconfig), GitHub attributes commits by author
# email, and the author is baked into the commit hash - so the only cure after
# the fact is a history rewrite. Catch it here, before it can be committed.
# Bypass: SKIP_IDENTITY_CHECK=1
if [ "${SKIP_IDENTITY_CHECK:-0}" != "1" ]; then
  _ident_email="$(git config user.email 2>/dev/null || true)"
  _ident_name="$(git config user.name 2>/dev/null || true)"
  _ident_bad=""

  case "$_ident_email" in
    "")                          _ident_bad="no user.email is configured" ;;
    *@*.*)                       : ;;
    *)                           _ident_bad="'$_ident_email' is not a valid address" ;;
  esac

  if [ -z "$_ident_bad" ]; then
    case "$_ident_email" in
      ?@?.*|?@??.*|??@?.*|??@??.*)          _ident_bad="'$_ident_email' looks like a throwaway address" ;;
      *@example.*|*@test.*|*@localhost|*@localhost.*)
                                            _ident_bad="'$_ident_email' is a placeholder domain" ;;
      test@*|foo@*|bar@*|dummy@*)           _ident_bad="'$_ident_email' looks like a placeholder address" ;;
    esac
  fi

  if [ -n "$_ident_bad" ]; then
    _ident_local="$(git config --local user.email 2>/dev/null || true)"
    echo "[pre-commit] BLOCKED: commit author identity is not usable — $_ident_bad" >&2
    echo "  author would be: ${_ident_name:-<no name>} <${_ident_email:-<no email>}>" >&2
    if [ -n "$_ident_local" ]; then
      echo "  source: a repo-local override in .git/config (it beats ~/.gitconfig)" >&2
      echo "  fix:    git config --unset user.email && git config --unset user.name" >&2
    else
      echo "  fix:    git config --global user.email 'you@example-real.com'" >&2
    fi
    echo "  then:   git config user.email   # confirm before committing" >&2
    echo "  bypass: SKIP_IDENTITY_CHECK=1 git commit ..." >&2
    exit 1
  fi
fi

# --- What did we stage? ----------------------------------------------------------
if [ "${QUALITYLAYER_PREFLIGHT_HEAD:-0}" = "1" ]; then
  # Release preflight checks the exact HEAD snapshot, whose index equals HEAD.
  staged="$(git ls-files --cached)"
else
  staged="$(git diff --cached --name-only --diff-filter=ACMR)"
fi
qualitylayer_changed=0
ui_changed=0
launcher_changed=0
tauri_changed=0
workflows_changed=0
shell_files=()
qualitylayer_files=()
typescript_staged=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    qualitylayer/app/launcher/*)  launcher_changed=1 ;;
    qualitylayer/app/src-tauri/*) tauri_changed=1 ;;
  esac
  case "$f" in
    qualitylayer/src/ui/*|qualitylayer/scripts/check-overflow.ts) qualitylayer_changed=1; ui_changed=1 ;;
    qualitylayer/*) qualitylayer_changed=1 ;;
    .github/workflows/*.yml|.github/workflows/*.yaml) workflows_changed=1 ;;
  esac
  case "$f" in
    *.sh|*.bash|.github/hooks/*) shell_files+=("$f") ;;
  esac
  case "$f" in
    qualitylayer/*) qualitylayer_files+=("${f#qualitylayer/}") ;;
  esac
  case "$f" in
    qualitylayer/*.ts|qualitylayer/*.tsx|qualitylayer/tsconfig*.json) typescript_staged=1 ;;
  esac
done < <(printf '%s\n' "$staged")

# rustup installs cargo here; a GUI git client's PATH often lacks it.
if [ -d "$HOME/.cargo/bin" ]; then PATH="$HOME/.cargo/bin:$PATH"; fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# --- Job registry (bash 3.2 compatible — no associative arrays) -----------------
job_names=()
job_pids=()
job_logs=()
job_durs=()
job_rcs=()
overall_start="$(date +%s)"
launch() { # launch "<display name>" <command…>
  local name="$1"; shift
  local idx="${#job_names[@]}"
  local log="$TMP/job_${idx}.log" dur="$TMP/job_${idx}.dur"
  job_names+=("$name"); job_logs+=("$log"); job_durs+=("$dur")
  if [ "$serial" = "1" ]; then
    echo "Pre-commit: running $name (serial)…"
    ( start="$(date +%s)"; "$@"; rc=$?; echo $(( $(date +%s) - start )) >"$dur"; exit "$rc" ) >"$log" 2>&1
    job_rcs+=("$?")
  else
    ( start="$(date +%s)"; "$@"; rc=$?; echo $(( $(date +%s) - start )) >"$dur"; exit "$rc" ) >"$log" 2>&1 &
    job_pids+=("$!")
  fi
}

have() { command -v "$1" >/dev/null 2>&1; }

# The job_* functions are run through `launch`, which shellcheck cannot follow.
# shellcheck disable=SC2329
job_qualitylayer() {
  cd "$qualitylayer_tree/qualitylayer" || return 1
  if [ "${QUALITYLAYER_PREFLIGHT_HEAD:-0}" = "1" ]; then
    bun run typecheck || return 1
    # Errors must not be hidden behind the warning limit; warnings remain available in normal lint.
    bun run lint -- --diagnostic-level=error --max-diagnostics=none || return 1
    return 0
  fi
  # Only what is staged is this commit's: another session's unfinished files do not block it.
  if [ "$typescript_staged" = "1" ]; then bun run typecheck || return 1; fi
  if [ "${#qualitylayer_files[@]}" -gt 0 ] && [ -x ./node_modules/.bin/biome ]; then
    ./node_modules/.bin/biome check --diagnostic-level=error --max-diagnostics=none \
      --files-ignore-unknown=true --no-errors-on-unmatched "${qualitylayer_files[@]}" || return 1
  fi
}
# A release binary built from what is staged must serve a Cockpit that draws:
# beta.1 to beta.5 shipped a white page while every development-build test passed.
# shellcheck disable=SC2329
job_cockpit() {
  cd qualitylayer || return 1
  bun run check:cockpit
}
# No text spills out of a control in any Cockpit view, at three widths (about a minute).
# shellcheck disable=SC2329
job_overflow() {
  cd qualitylayer || return 1
  bun run check:overflow
}
# shellcheck disable=SC2329
job_plaintext() {
  bash .github/scripts/check_qualitylayer_encrypted.sh
}
# The App's Rust crates: formatted, and clippy-clean with warnings as errors.
# shellcheck disable=SC2329
job_rust() { # job_rust <crate dir under qualitylayer/app>
  cd "qualitylayer/app/$1" || return 1
  cargo fmt --check || return 1
  cargo clippy --all-targets --locked --quiet -- -D warnings || return 1
}
# shellcheck disable=SC2329
job_shellcheck() {
  shellcheck "${shell_files[@]}"
}
# shellcheck disable=SC2329
job_actionlint() {
  # A checked-out commit tree need not contain Git's metadata directory.
  local workflows=() file
  for file in .github/workflows/*.yml .github/workflows/*.yaml; do
    [ ! -f "$file" ] || workflows+=("$file")
  done
  [ "${#workflows[@]}" -eq 0 ] || actionlint "${workflows[@]}"
}
# shellcheck disable=SC2329
job_trivy() {
  trivy fs . \
    --scanners vuln,secret \
    --severity CRITICAL,HIGH \
    --exit-code 1 \
    --ignore-unfixed \
    --skip-dirs node_modules,qualitylayer/node_modules,qualitylayer/dist,docs/site/api,docs/site/node_modules,docs/docusaurus/node_modules,.pnpm-store \
    --ignorefile .trivyignore \
    --quiet
}

# --- Schedule --------------------------------------------------------------------
# The tree the typecheck and Biome read: the checkout, or, when another session has unstaged or
# new files under qualitylayer/, the staged tree checked out of the index (smudge filters run).
qualitylayer_tree="$PWD"
if [ "$qualitylayer_changed" = "1" ] && [ "${QUALITYLAYER_PREFLIGHT_HEAD:-0}" != "1" ] \
  && have bun && [ -d qualitylayer/node_modules ]; then
  if ! git diff --quiet -- qualitylayer \
    || [ -n "$(git ls-files --others --exclude-standard -- qualitylayer | head -n 1)" ]; then
    # The tests import from docs/site too, so both folders are checked out.
    mkdir -p "$TMP/staged" \
      && git ls-files -z -- qualitylayer docs/site | xargs -0 git checkout-index --prefix="$TMP/staged/" -- \
      && ln -s "$PWD/qualitylayer/node_modules" "$TMP/staged/qualitylayer/node_modules" \
      && { [ ! -d docs/site/node_modules ] || ln -s "$PWD/docs/site/node_modules" "$TMP/staged/docs/site/node_modules"; } \
      && qualitylayer_tree="$TMP/staged"
    if [ "$qualitylayer_tree" != "$TMP/staged" ]; then
      echo "⚠ could not check out the staged tree — checking the working copy instead."
    fi
  fi
fi

if [ "$qualitylayer_changed" = "1" ]; then
  if have bun && [ -d qualitylayer/node_modules ]; then
    launch "qualitylayer (typecheck+lint)" job_qualitylayer
    launch "qualitylayer (release Cockpit draws)" job_cockpit
    if [ "$ui_changed" = "1" ]; then launch "qualitylayer (no text overflows a control)" job_overflow; fi
  else
    echo "⚠ bun or qualitylayer deps unavailable — skipping (cd qualitylayer && bun install)."
  fi
fi

if have git-crypt; then
  launch "plaintext guard" job_plaintext
else
  echo "⚠ git-crypt not installed — skipping the plaintext guard (CI is the gate)."
fi

if [ "$launcher_changed" = "1" ] || [ "$tauri_changed" = "1" ]; then
  if have cargo; then
    if [ "$launcher_changed" = "1" ]; then launch "app/launcher (fmt+clippy)" job_rust launcher; fi
    if [ "$tauri_changed" = "1" ]; then launch "app/src-tauri (fmt+clippy)" job_rust src-tauri; fi
  else
    echo "⚠ cargo not installed — skipping the App's Rust checks (rustup.rs)."
  fi
fi

if [ "${#shell_files[@]}" -gt 0 ]; then
  if have shellcheck; then
    launch "shell scripts (shellcheck)" job_shellcheck
  else
    echo "⚠ shellcheck not installed — skipping (brew install shellcheck)."
  fi
fi

if [ "$workflows_changed" = "1" ]; then
  if have actionlint; then
    launch "workflows (actionlint)" job_actionlint
  else
    echo "⚠ actionlint not installed — skipping (brew install actionlint)."
  fi
fi

if [ "${SKIP_TRIVY:-0}" != "1" ]; then
  if have trivy; then
    launch "trivy (vuln+secret)" job_trivy
  else
    echo "⚠ trivy not installed — skipping security scan (brew install trivy)."
  fi
fi

if [ "${#job_names[@]}" -eq 0 ]; then
  echo "Pre-commit: no relevant checks for the staged files — nothing to run."
  exit 0
fi

if [ "$serial" = "0" ]; then
  echo "Pre-commit: running ${#job_names[@]} check(s) in parallel…"
  for i in "${!job_names[@]}"; do
    if wait "${job_pids[$i]}"; then job_rcs+=("0"); else job_rcs+=("$?"); fi
  done
fi

failed=0
for i in "${!job_names[@]}"; do
  if [ "${job_rcs[$i]}" != "0" ]; then
    failed=1
    echo ""
    echo "──────── ✖ ${job_names[$i]} ────────"
    cat "${job_logs[$i]}"
  fi
done

echo ""
echo "──────── pre-commit summary ($(( $(date +%s) - overall_start ))s wall) ────────"
for i in "${!job_names[@]}"; do
  dur="$(cat "${job_durs[$i]}" 2>/dev/null || echo '?')"
  if [ "${job_rcs[$i]}" = "0" ]; then
    echo "  ✔ ${job_names[$i]} (${dur}s)"
  else
    echo "  ✖ ${job_names[$i]} (${dur}s) — exit ${job_rcs[$i]}"
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "" >&2
  echo "✖ Pre-commit failed. Fix the above, or bypass with SKIP_PRECOMMIT=1 / git commit --no-verify" >&2
  exit 1
fi

echo ""
echo "✔ All pre-commit checks passed."
exit 0
