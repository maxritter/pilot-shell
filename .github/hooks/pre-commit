#!/usr/bin/env bash
# Pre-commit hook: the fast CI checks, in parallel, scoped to what is staged.
#
#   • qualitylayer   Biome on the staged files; typecheck when TypeScript is staged; the release
#                    Cockpit build and the overflow check. All of them run on an isolated
#                    staged tree   (qualitylayer/ staged)
#   • app (Rust)     cargo fmt --check + clippy -D warnings   (a crate under app/ staged)
#   • plaintext      nothing under qualitylayer/ staged in plaintext   (always)
#   • shell          shellcheck                          (shell scripts or hooks staged)
#   • workflows      actionlint                          (.github/workflows/ staged)
#   • trivy          vuln + secret scan                  (always)
#
# The test suite is CI's job (`bun run test --all` in qualitylayer/, a few minutes).
# Missing local tools are skipped with a warning, never blocking: CI is the gate.
#
# Install: ln -sf ../../.github/hooks/pre-commit .git/hooks/pre-commit
# Fix failed checks before retrying the commit. Repository work must pass these gates.

set -uo pipefail

serial="${QUALITYLAYER_PRECOMMIT_SERIAL:-0}"
case "$serial" in
  0|1) : ;;
  *) echo "invalid QUALITYLAYER_PRECOMMIT_SERIAL: expected 0 or 1" >&2; exit 1 ;;
esac

if [ "${SKIP_PRECOMMIT:-0}" = "1" ]; then
  echo "⚠ SKIP_PRECOMMIT=1 — skipping all pre-commit checks."
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

# --- Author identity gate ------------------------------------------------------
#
# A throwaway identity in .git/config silently re-authors every commit in the
# repo (repo config wins over ~/.gitconfig), GitHub attributes commits by author
# email, and the author is baked into the commit hash - so the only cure after
# the fact is a history rewrite. Catch it here, before it can be committed.
# Confirm the intended author identity before committing.
if [ "${SKIP_IDENTITY_CHECK:-0}" != "1" ]; then
  _ident_email="$(git config user.email 2>/dev/null || true)"
  _ident_name="$(git config user.name 2>/dev/null || true)"
  _ident_bad=""

  case "$_ident_email" in
    "")                          _ident_bad="no user.email is configured" ;;
    *@*.*)                       : ;;
    *)                           _ident_bad="'$_ident_email' is not a valid address" ;;
  esac

  if [ -z "$_ident_bad" ]; then
    case "$_ident_email" in
      ?@?.*|?@??.*|??@?.*|??@??.*)          _ident_bad="'$_ident_email' looks like a throwaway address" ;;
      *@example.*|*@test.*|*@localhost|*@localhost.*)
                                            _ident_bad="'$_ident_email' is a placeholder domain" ;;
      test@*|foo@*|bar@*|dummy@*)           _ident_bad="'$_ident_email' looks like a placeholder address" ;;
    esac
  fi

  if [ -n "$_ident_bad" ]; then
    _ident_local="$(git config --local user.email 2>/dev/null || true)"
    echo "[pre-commit] BLOCKED: commit author identity is not usable — $_ident_bad" >&2
    echo "  author would be: ${_ident_name:-<no name>} <${_ident_email:-<no email>}>" >&2
    if [ -n "$_ident_local" ]; then
      echo "  source: a repo-local override in .git/config (it beats ~/.gitconfig)" >&2
      echo "  fix:    git config --unset user.email && git config --unset user.name" >&2
    else
      echo "  fix:    git config --global user.email 'you@example-real.com'" >&2
    fi
    echo "  then:   git config user.email   # confirm before committing" >&2
    echo "  retry the commit normally after correcting the identity." >&2
    exit 1
  fi
fi

# A configured registry helper missing from PATH would otherwise fail only after the staged copy.
if [ "${SKIP_TRIVY:-0}" != "1" ] && command -v trivy >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  _ql_docker_file="${DOCKER_CONFIG:-${HOME}/.docker}/config.json"
  if ! _ql_scan_helpers="$(python3 -I - "$_ql_docker_file" <<'PY'
import json, os, pathlib, re, sys
try:
    raw = os.environ.get("DOCKER_AUTH_CONFIG")
    path = pathlib.Path(sys.argv[1])
    if raw is None and not path.is_file():
        sys.exit(0)
    if raw is None and path.stat().st_size > 1024 * 1024:
        raise ValueError("registry configuration exceeds its cap")
    config = json.loads(raw if raw is not None else path.read_text())
    helpers = [config.get("credsStore"), *config.get("credHelpers", {}).values()]
    for name in sorted({name for name in helpers if name}):
        if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9_.-]+", name):
            raise ValueError("invalid registry helper name")
        print("docker-credential-" + name)
except Exception:
    print("Pre-commit could not inspect the configured registry credential helpers.", file=sys.stderr)
    sys.exit(1)
PY
)"; then
    exit 1
  fi
  while IFS= read -r _ql_scan_helper; do
    [ -n "$_ql_scan_helper" ] || continue
    if ! command -v "$_ql_scan_helper" >/dev/null 2>&1; then
      echo "✖ Pre-commit prerequisite: configured registry helper $_ql_scan_helper is not executable on this PATH." >&2
      echo "  Restore the existing helper's directory to PATH, then retry. No staged snapshot or security scan was started." >&2
      exit 1
    fi
  done <<<"$_ql_scan_helpers"
fi

TMP="$(mktemp -d)" || exit 1
trap 'rm -rf "${TMP:?}"' EXIT

# Git replaces index files atomically. Copy that single snapshot before any staged reads;
# never refresh the caller's shared or private index. write-tree omits intent-to-add entries
# and resolves split indexes; read-tree gives the checks only the actual candidate tree.
if ! caller_index="$(git rev-parse --git-path index)" \
  || ! cp "$caller_index" "$TMP/index"; then
  echo "✖ Pre-commit refused: could not freeze the staged index." >&2
  exit 1
fi
export GIT_INDEX_FILE="$TMP/index"
if ! staged_tree="$(git -c core.splitIndex=false write-tree)" \
  || ! git -c core.splitIndex=false read-tree "$staged_tree"; then
  echo "✖ Pre-commit refused: could not resolve the staged tree." >&2
  exit 1
fi

# --- What did we stage? ----------------------------------------------------------
if [ "${QUALITYLAYER_PREFLIGHT_HEAD:-0}" = "1" ]; then
  # Release preflight checks the exact HEAD snapshot, whose index equals HEAD.
  staged="$(git ls-files --cached)"
else
  staged="$(git diff --cached --name-only --diff-filter=ACMR)"
fi
# A helper's temporary file left in the shared checkout is never committed (Polish's
# ql-debug-polish-shots.spec.ts went into another session's commit on 2026-10-13).
debug_files="$(printf '%s\n' "$staged" | grep -E '(^|/)ql-debug[^/]*$' || true)"
if [ -n "$debug_files" ]; then
  echo "✖ Pre-commit refused: temporary ql-debug files are staged. Unstage them (they belong in a temp folder):" >&2
  printf '%s\n' "$debug_files" | sed 's/^/  /' >&2
  exit 1
fi
qualitylayer_changed=0
ui_changed=0
launcher_changed=0
tauri_changed=0
workflows_changed=0
shell_files=()
qualitylayer_files=()
typescript_staged=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    qualitylayer/app/launcher/*)  launcher_changed=1 ;;
    qualitylayer/app/src-tauri/*) tauri_changed=1 ;;
  esac
  case "$f" in
    qualitylayer/src/ui/*|qualitylayer/scripts/check-overflow.ts) qualitylayer_changed=1; ui_changed=1 ;;
    qualitylayer/*) qualitylayer_changed=1 ;;
    .github/workflows/*.yml|.github/workflows/*.yaml) workflows_changed=1 ;;
  esac
  case "$f" in
    *.sh|*.bash|.github/hooks/*) shell_files+=("$f") ;;
  esac
  case "$f" in
    qualitylayer/*) qualitylayer_files+=("${f#qualitylayer/}") ;;
  esac
  case "$f" in
    qualitylayer/*.ts|qualitylayer/*.tsx|qualitylayer/tsconfig*.json) typescript_staged=1 ;;
  esac
done < <(printf '%s\n' "$staged")

# rustup installs cargo here; a GUI git client's PATH often lacks it.
if [ -d "$HOME/.cargo/bin" ]; then PATH="$HOME/.cargo/bin:$PATH"; fi

# --- Job registry (bash 3.2 compatible — no associative arrays) -----------------
job_names=()
job_pids=()
job_logs=()
job_durs=()
job_rcs=()
overall_start="$(date +%s)"
launch() { # launch "<display name>" <command…>
  local name="$1"; shift
  local idx="${#job_names[@]}"
  local log="$TMP/job_${idx}.log" dur="$TMP/job_${idx}.dur"
  job_names+=("$name"); job_logs+=("$log"); job_durs+=("$dur")
  if [ "$serial" = "1" ]; then
    echo "Pre-commit: running $name (serial)…"
    ( start="$(date +%s)"; "$@"; rc=$?; echo $(( $(date +%s) - start )) >"$dur"; exit "$rc" ) >"$log" 2>&1
    job_rcs+=("$?")
  else
    ( start="$(date +%s)"; "$@"; rc=$?; echo $(( $(date +%s) - start )) >"$dur"; exit "$rc" ) >"$log" 2>&1 &
    job_pids+=("$!")
  fi
}

have() { command -v "$1" >/dev/null 2>&1; }

# The job_* functions are run through `launch`, which shellcheck cannot follow.
# shellcheck disable=SC2329
job_qualitylayer() {
  cd "$qualitylayer_tree/qualitylayer" || return 1
  if [ "${QUALITYLAYER_PREFLIGHT_HEAD:-0}" = "1" ]; then
    bun run typecheck || return 1
    # Errors must not be hidden behind the warning limit; warnings remain available in normal lint.
    bun run lint -- --diagnostic-level=error --max-diagnostics=none || return 1
    return 0
  fi
  # Only what is staged is this commit's: another session's unfinished files do not block it.
  if [ "$typescript_staged" = "1" ]; then bun run typecheck || return 1; fi
  if [ "${#qualitylayer_files[@]}" -gt 0 ] && [ -x ./node_modules/.bin/biome ]; then
    ./node_modules/.bin/biome check --diagnostic-level=error --max-diagnostics=none \
      --files-ignore-unknown=true --no-errors-on-unmatched "${qualitylayer_files[@]}" || return 1
  fi
}
# A release binary built from what is staged must serve a Cockpit that draws:
# beta.1 to beta.5 shipped a white page while every development-build test passed.
# shellcheck disable=SC2329
job_cockpit() {
  # The staged tree (see Schedule): another session's unfinished edit must not fail this commit.
  cd "$qualitylayer_tree/qualitylayer" || return 1
  bun run check:cockpit
}
# No text spills out of a control in any Cockpit view, at three widths (about a minute).
# shellcheck disable=SC2329
job_overflow() {
  cd "$qualitylayer_tree/qualitylayer" || return 1
  bun run check:overflow
}
# Both browser checks retain their own assertions; release startup precedes the layout matrix.
# shellcheck disable=SC2329
job_browser_checks() {
  job_cockpit || return 1
  if [ "$ui_changed" = "1" ]; then job_overflow || return 1; fi
}
# shellcheck disable=SC2329
job_plaintext() {
  ( cd "$qualitylayer_tree" && GIT_DIR="$repo_git_dir" GIT_WORK_TREE="$qualitylayer_tree" \
      bash .github/scripts/check_qualitylayer_encrypted.sh --staged )
}
# The App's Rust crates: formatted, and clippy-clean with warnings as errors.
# shellcheck disable=SC2329
job_rust() { # job_rust <crate dir under qualitylayer/app>
  cd "qualitylayer/app/$1" || return 1
  cargo fmt --check || return 1
  cargo clippy --all-targets --locked --quiet -- -D warnings || return 1
}
# shellcheck disable=SC2329
job_shellcheck() {
  cd "$qualitylayer_tree" || return 1
  shellcheck "${shell_files[@]}"
}
# shellcheck disable=SC2329
job_actionlint() {
  cd "$qualitylayer_tree" || return 1
  # A checked-out commit tree need not contain Git's metadata directory.
  local workflows=() file
  for file in .github/workflows/*.yml .github/workflows/*.yaml; do
    [ ! -f "$file" ] || workflows+=("$file")
  done
  [ "${#workflows[@]}" -eq 0 ] || actionlint "${workflows[@]}"
}
# shellcheck disable=SC2329
job_trivy() {
  cd "$qualitylayer_tree" || return 1
  trivy fs . \
    --scanners vuln,secret \
    --severity CRITICAL,HIGH \
    --exit-code 1 \
    --ignore-unfixed \
    --skip-dirs node_modules,qualitylayer/node_modules,qualitylayer/dist,qualitylayer/app/launcher/target,qualitylayer/app/src-tauri/target,docs/site/api,docs/site/node_modules,docs/docusaurus/node_modules,.pnpm-store \
    --ignorefile .trivyignore \
    --quiet
}

# Materialize only immutable index blobs: index-equal working files can change during a copy.
# The unchanged committed filter can serve encrypted blobs in one process; other configurations
# retain Git's configured smudge path, with no working-copy fallback on failure.
stage_tree() { # stage_tree <dir>
  local out="$1" paths="$TMP/staged-paths" started git_dir common_dir key script
  local candidate_helper committed_helper process_filter="" filter_config=()
  started="$(date +%s)"
  git_dir="$(git rev-parse --absolute-git-dir)" || return 1
  git ls-files --cached -z >"$paths" || return 1
  # Reuse only the unchanged, committed filter implementation, never a working-copy edit.
  # This config applies to this checkout-index command only; keys stay in Git metadata.
  script=".github/workflows/scripts/git-crypt-unlock.ts"
  candidate_helper="$(git rev-parse --verify ":$script" 2>/dev/null || true)"
  committed_helper="$(git rev-parse --verify "HEAD:$script" 2>/dev/null || true)"
  key="$git_dir/git-crypt/keys/default"
  if [ ! -r "$key" ]; then
    common_dir="$(git rev-parse --git-common-dir)" || return 1
    common_dir="$(cd "$common_dir" && pwd -P)" || return 1
    key="$common_dir/git-crypt/keys/default"
  fi
  if [ -n "$candidate_helper" ] && [ "$candidate_helper" = "$committed_helper" ] \
    && [ -r "$key" ] && have bun && have python3; then
    git cat-file blob "$candidate_helper" >"$TMP/git-crypt-unlock.ts" || return 1
    process_filter="$(python3 -I - "$(command -v bun)" "$TMP/git-crypt-unlock.ts" "$key" <<'PY'
import shlex, sys
print(shlex.join([sys.argv[1], sys.argv[2], "filter", sys.argv[3]]))
PY
)" || return 1
    filter_config=(-c "filter.git-crypt.process=$process_filter" -c "filter.git-crypt.required=true")
  fi
  # Resolve attributes against the empty output worktree and frozen index, never unstaged
  # .gitattributes in the shared checkout. checkout-index preserves modes and runs smudge.
  ( cd "$out" && git ${filter_config[@]+"${filter_config[@]}"} --git-dir="$git_dir" --work-tree="$out" \
      checkout-index --force -z --stdin <"$paths" ) || return 1
  echo "Pre-commit: staged tree ready in $(($(date +%s) - started))s ($(tr -cd '\0' <"$paths" | wc -c | tr -d ' ') file(s) from the index)."
}

link_dependencies() { # link_dependencies <borrowed directory> <snapshot destination>
  local source="$1" destination="$2"
  if [ -e "$destination" ] || [ -L "$destination" ]; then
    echo "✖ Pre-commit refused: staged dependency destination already exists: $destination" >&2
    return 1
  fi
  ln -s "$source" "$destination"
}

# --- Schedule --------------------------------------------------------------------
# Security and workflow-only commits need the complete candidate too: every tracked manifest
# (including Docusaurus and video), source and scanner configuration comes from the frozen index.
# Ignored local candidates never enter this tree. Borrow dependencies only for the App jobs.
repo_git_dir="$(git rev-parse --absolute-git-dir)" || exit 1
qualitylayer_tree="$TMP/staged"
if ! { mkdir -p "$qualitylayer_tree" && stage_tree "$qualitylayer_tree"; }; then
  echo "✖ Pre-commit refused: could not materialize the staged tree; no working-copy fallback." >&2
  exit 1
fi
if [ "$qualitylayer_changed" = "1" ] && have bun && [ -d qualitylayer/node_modules ]; then
  if ! { link_dependencies "$PWD/qualitylayer/node_modules" "$qualitylayer_tree/qualitylayer/node_modules" \
    && { [ ! -d docs/site/node_modules ] || link_dependencies "$PWD/docs/site/node_modules" "$TMP/staged/docs/site/node_modules"; }; }; then
    echo "✖ Pre-commit refused: could not materialize the staged tree; no working-copy fallback." >&2
    exit 1
  fi
fi

# A note, never a blocker: the website model's sync manifest records a hash for each source file
# its generated pages were built from, so a staged change to one leaves the manifest behind.
website_note="$qualitylayer_tree/qualitylayer/scripts/website-model-stale.ts"
if have bun && [ -f "$website_note" ]; then
  printf '%s\n' "$staged" | bun "$website_note" "$qualitylayer_tree" || true
fi

if [ "$qualitylayer_changed" = "1" ]; then
  if have bun && [ -d qualitylayer/node_modules ]; then
    launch "qualitylayer (typecheck+lint)" job_qualitylayer
    launch "qualitylayer (release Cockpit and controls)" job_browser_checks
  else
    echo "⚠ bun or qualitylayer deps unavailable — skipping (cd qualitylayer && bun install)."
  fi
fi

# The staged blobs' own headers: no key and no git-crypt needed, so it always runs.
launch "plaintext guard" job_plaintext

if [ "$launcher_changed" = "1" ] || [ "$tauri_changed" = "1" ]; then
  if have cargo; then
    if [ "$launcher_changed" = "1" ]; then launch "app/launcher (fmt+clippy)" job_rust launcher; fi
    if [ "$tauri_changed" = "1" ]; then launch "app/src-tauri (fmt+clippy)" job_rust src-tauri; fi
  else
    echo "⚠ cargo not installed — skipping the App's Rust checks (rustup.rs)."
  fi
fi

if [ "${#shell_files[@]}" -gt 0 ]; then
  if have shellcheck; then
    launch "shell scripts (shellcheck)" job_shellcheck
  else
    echo "⚠ shellcheck not installed — skipping (brew install shellcheck)."
  fi
fi

if [ "$workflows_changed" = "1" ]; then
  if have actionlint; then
    launch "workflows (actionlint)" job_actionlint
  else
    echo "⚠ actionlint not installed — skipping (brew install actionlint)."
  fi
fi

if [ "${SKIP_TRIVY:-0}" != "1" ]; then
  if have trivy; then
    launch "trivy (vuln+secret)" job_trivy
  else
    echo "⚠ trivy not installed — skipping security scan (brew install trivy)."
  fi
fi

if [ "${#job_names[@]}" -eq 0 ]; then
  echo "Pre-commit: no relevant checks for the staged files — nothing to run."
  exit 0
fi

if [ "$serial" = "0" ]; then
  echo "Pre-commit: running ${#job_names[@]} check(s) in parallel…"
  for i in "${!job_names[@]}"; do
    if wait "${job_pids[$i]}"; then job_rcs+=("0"); else job_rcs+=("$?"); fi
  done
fi

failed=0
failed_names=()
for i in "${!job_names[@]}"; do
  if [ "${job_rcs[$i]}" != "0" ]; then
    failed=1
    failed_names+=("${job_names[$i]} (exit ${job_rcs[$i]})")
    echo ""
    echo "──────── ✖ ${job_names[$i]} ────────"
    if [ -s "${job_logs[$i]}" ]; then
      cat "${job_logs[$i]}"
    else
      # A job killed under load (a signal, a timeout) can end without a word: say so.
      echo "(no output; exit ${job_rcs[$i]}: it may have been killed or timed out, so run the commit again)"
    fi
  fi
done

echo ""
echo "──────── pre-commit summary ($(( $(date +%s) - overall_start ))s wall) ────────"
for i in "${!job_names[@]}"; do
  dur="$(cat "${job_durs[$i]}" 2>/dev/null || echo '?')"
  if [ "${job_rcs[$i]}" = "0" ]; then
    echo "  ✔ ${job_names[$i]} (${dur}s)"
  else
    echo "  ✖ ${job_names[$i]} (${dur}s) — exit ${job_rcs[$i]}"
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "" >&2
  failed_list="$(printf '%s, ' "${failed_names[@]}")"
  echo "✖ Pre-commit failed: ${failed_list%, }. Fix the failed checks above, then retry the commit normally." >&2
  exit 1
fi

echo ""
echo "✔ All pre-commit checks passed."
exit 0
