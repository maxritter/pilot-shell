{
  "name": "qualitylayer",
  "version": "12.0.0-beta.23",
  "private": true,
  "type": "module",
  "imports": {
    "#workflow": {
      "sealed": "./src/workflow/sealed.ts",
      "default": "./src/workflow/assets.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "deadcode": "knip",
