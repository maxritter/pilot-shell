    "build": "bun run scripts/build.ts",
    "app:build": "bun run scripts/app.ts",
    "app:dev": "bun run scripts/app.ts --run",
    "install:local": "bun run scripts/install-local.ts",
    "app:icon": "bun run scripts/app-icon.ts",
    "check:cockpit": "bun scripts/check-cockpit.ts --build",
    "check:overflow": "bun scripts/check-overflow.ts",
    "dev:skill": "bun run scripts/dev-skill.ts",
    "release-gate": "bun run tests/release/run-agent.ts",
    "beta-smoke": "bun run tests/release/beta-smoke.ts",
    "evals": "bun run tests/release/evals.ts",
    "eval:activation": "bun run tests/release/activation.ts",
    "proof:docker": "bun run tests/proof/docker/run.ts",
    "proof:done-means": "bun run tests/release/done-means.ts",
    "proof:team-agents": "bun run tests/release/team-agents.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16",
    "@types/bun": "^1.3.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "happy-dom": "^20.14.5",
    "javascript-obfuscator": "5.8.0",
    "knip": "6.38.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "lodash-es": "^4.18.0",
    "dompurify": "^3.4.16",
    "source-map-js": "^1.2.2"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@happy-dom/global-registrator": "^20.14.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "radix-ui": "^1.6.7",
    "react": "19",
    "react-dom": "19",
    "sonner": "^2.0.8"
