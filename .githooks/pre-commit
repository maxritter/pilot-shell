#!/usr/bin/env bash
# Shim — the real hook is .github/hooks/pre-commit.
#
# Two entry points exist and both must run the SAME checks:
#   • core.hooksPath=.githooks   → git runs THIS file
#   • .git/hooks/pre-commit      → a symlink to ../../.github/hooks/pre-commit
#
# They used to be two independently maintained copies, and they silently
# drifted: `core.hooksPath` overrides `.git/hooks/` entirely, so the symlinked
# (and documented) implementation stopped running while edits kept landing on
# it. Keeping this file a shim means there is one implementation to maintain
# and no way for the two paths to diverge again.
#
# Bypass flags and everything else are documented in the real hook.
exec "$(git rev-parse --show-toplevel)/.github/hooks/pre-commit" "$@"
