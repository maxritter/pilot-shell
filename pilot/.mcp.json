{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@2.1.4"]
    },
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "~/.local/bin/codebase-memory-mcp"],
      "env": {}
    },
    "mem-search": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "bun run ~/.claude/pilot/scripts/mcp-server.cjs"]
    },
    "web-search": {
      "command": "npx",
      "args": ["-y", "open-websearch@1.2.7"],
      "env": {
        "MODE": "stdio",
        "DEFAULT_SEARCH_ENGINE": "duckduckgo",
        "ALLOWED_SEARCH_ENGINES": "duckduckgo,bing,exa"
      }
    },
    "grep-mcp": {
      "type": "http",
      "url": "https://mcp.grep.app"
    },
    "web-fetch": {
      "command": "npx",
      "args": ["-y", "fetcher-mcp@0.3.9"]
    }
  }
}
